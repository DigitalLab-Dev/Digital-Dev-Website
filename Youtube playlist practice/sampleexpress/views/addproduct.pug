extends layout 

block content 
    include ./navbar.pug 
    form(method="POST" action="/addproduct") 
        .mb-3 
            label.form-label(for="name") Name 
            input.form-control(type="text" id="name" name="name" required) 
        .mb-3 
            label.form-label(for="price") Price 
            input.form-control(type="number" id="price" name="price" step="0.01" required) 
        .mb-3 
            label.form-label(for="description") Description 
            textarea.form-control(id="description" name="description" rows="3") 
        input.btn.btn-primary(type="submit")